# Full-site image. A clean public checkout intentionally FAILS until authorized
# private course assets are restored. Never silently ship an empty Pathline.
FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/as-v3-reference GMF_ENV=production \
    GMF_AUTH_MODE=password GMF_DATA_DIR=/var/data/gmf GMF_MIN_PUBLISHED=369
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim \
    fonts-noto-cjk fonts-dejavu-core gosu && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-dev.txt ./
COPY as-v3-reference/requirements.txt as-v3-reference/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY dist dist
COPY scripts/verify-v43-deploy.py scripts/verify-v43-deploy.py
COPY scripts/verify-public-bank.py scripts/verify-public-bank.py
# Build MUST fail before image publication when any textbook image/topic is missing.
RUN python scripts/verify-v43-deploy.py --dist dist --mode assets-only
COPY backend backend
COPY as-v3-reference/gmf_v3 as-v3-reference/gmf_v3
COPY deploy/public-entrypoint.sh /entrypoint.sh
RUN groupadd --gid 10001 gmf && useradd --uid 10001 --gid 10001 --create-home gmf \
    && chmod 755 /entrypoint.sh
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v4/ready',timeout=5)"
ENTRYPOINT ["/entrypoint.sh"]
